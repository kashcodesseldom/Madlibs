/* Madlib Game: soft pink pastel, glass UI */
:root {
  --blush-50: #fff6f9;
  --blush-100: #ffe8f0;
  --petal: #f9b8d1;
  --rose: #ee8fb2;
  --rose-deep: #b8416f;
  --ink: #4a2238;
  --ink-soft: #7d5068;
  --glass: rgba(255, 255, 255, 0.42);
  --glass-strong: rgba(255, 255, 255, 0.66);
  --glass-edge: rgba(255, 255, 255, 0.78);
  --radius-lg: 28px;
  --radius-md: 18px;
  --radius-pill: 999px;
  --shadow: 0 10px 40px rgba(184, 65, 111, 0.14);
  --font-display: "Bricolage Grotesque", "Trebuchet MS", system-ui, sans-serif;
  --font-body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font-body);
  color: var(--ink);
  line-height: 1.6;
  background: linear-gradient(135deg, #ffeef4 0%, #ffdce9 45%, #fde4f1 75%, #ffefe6 100%);
  background-attachment: fixed;
}

/* soft colour blobs behind the glass */
.backdrop { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
.backdrop i { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.8; }
.backdrop i:nth-child(1) { width: 46vmax; height: 46vmax; background: #ffb4d2; top: -16vmax; left: -12vmax; }
.backdrop i:nth-child(2) { width: 38vmax; height: 38vmax; background: #f6c6ec; top: 20vh; right: -14vmax; }
.backdrop i:nth-child(3) { width: 42vmax; height: 42vmax; background: #ffd5c8; bottom: -18vmax; left: 22vw; }

h1, h2, h3 { font-family: var(--font-display); line-height: 1.12; letter-spacing: -0.015em; margin: 0 0 0.6rem; }
h1 { font-size: clamp(2rem, 5.2vw, 3.5rem); font-weight: 700; }
h2 { font-size: 1.3rem; font-weight: 600; }
p { margin: 0 0 1rem; }
a { color: var(--rose-deep); }
:focus-visible { outline: 3px solid var(--rose-deep); outline-offset: 2px; }

/* glass */
.glass {
  background: var(--glass);
  border: 1px solid var(--glass-edge);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.85);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass { background: rgba(255, 255, 255, 0.8); }
}

/* layout */
.page { width: min(1100px, 100% - 2rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
.panel { padding: clamp(1.25rem, 3vw, 2rem); }
.lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 52ch; }
.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
.site-footer { text-align: center; color: var(--ink-soft); font-size: 0.95rem; padding: 0 1rem 2rem; }

/* nav */
.nav {
  width: min(1100px, 100% - 2rem); margin: 1rem auto 0; padding: 0.6rem 0.8rem 0.6rem 1.3rem;
  display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;
  border-radius: var(--radius-pill);
}
.brand { display: inline-flex; align-items: center; gap: 0.4rem; font: 700 1.4rem var(--font-display); color: var(--ink); text-decoration: none; }
.brand-blank { width: 1.7rem; height: 0.85rem; border-radius: var(--radius-pill); border: 1.5px dashed var(--rose); background: rgba(255, 255, 255, 0.6); }
.nav-links { display: flex; flex-wrap: wrap; gap: 0.25rem; }
.nav-links a { padding: 0.45rem 0.95rem; border-radius: var(--radius-pill); color: var(--ink); text-decoration: none; font-weight: 500; }
.nav-links a:hover, .nav-links a[aria-current="page"] { background: rgba(255, 255, 255, 0.75); }

/* the blank: the game's one recurring shape */
.blank {
  display: inline-block; padding: 0 0.6em; margin: 0 0.05em; border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.55); border: 1.5px dashed var(--rose);
  color: var(--rose-deep); font-style: italic; font-size: 0.82em; line-height: 1.55;
}
.blank.filled, mark.word {
  background: linear-gradient(135deg, #ffcade, #f9a8c8); border: 1px solid rgba(255, 255, 255, 0.85);
  color: var(--ink); font-style: normal; font-weight: 600;
}
mark.word { display: inline-block; padding: 0.02em 0.5em; border-radius: var(--radius-pill); line-height: 1.5; }

/* buttons, chips, tags */
.btn {
  display: inline-flex; align-items: center; justify-content: center; padding: 0.75rem 1.4rem;
  border-radius: var(--radius-pill); border: 1px solid var(--glass-edge); color: var(--ink);
  font: 600 1rem var(--font-body); text-decoration: none; cursor: pointer;
}
.btn-primary { background: linear-gradient(135deg, #ffc3da, #f69bc0); box-shadow: 0 6px 20px rgba(238, 143, 178, 0.45); }
.btn-ghost { background: var(--glass-strong); }
.btn:hover { filter: brightness(1.04); }
.btn:disabled { opacity: 0.6; cursor: wait; }
.tag {
  display: inline-block; align-self: flex-start; margin-bottom: 0.75rem; padding: 0.1rem 0.8rem;
  border-radius: var(--radius-pill); background: rgba(255, 255, 255, 0.7); border: 1px solid var(--glass-edge);
  color: var(--rose-deep); font-size: 0.88rem; font-weight: 600;
}
.filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.75rem 0 1.25rem; }
.chip {
  padding: 0.4rem 1.05rem; border-radius: var(--radius-pill); border: 1px solid var(--glass-edge);
  background: var(--glass); color: var(--ink); text-decoration: none; font-weight: 500;
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
}
.chip:hover { background: var(--glass-strong); }
.chip.active { background: linear-gradient(135deg, #ffc3da, #f69bc0); font-weight: 600; }

/* home */
.hero { padding: 2.5rem 0 0.5rem; max-width: 780px; }
.hero h1 { margin-bottom: 1rem; }
.hero h1 .blank { font-size: 0.68em; vertical-align: 0.12em; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }
.card { display: flex; flex-direction: column; padding: 1.4rem; color: var(--ink); text-decoration: none; }
.card:hover { background: var(--glass-strong); }
.card p { color: var(--ink-soft); }
.meta { margin-top: auto; font-size: 0.92rem; color: var(--ink-soft); }
.notice { max-width: 640px; }
.flash { padding: 0.8rem 1.3rem; border-radius: var(--radius-md); margin-bottom: 1rem; }

/* play */
.play-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
.preview-panel { position: sticky; top: 1rem; }
.story-text { white-space: pre-line; font-size: 1.1rem; line-height: 1.85; max-width: 62ch; margin: 0; }
.progress { height: 10px; border-radius: var(--radius-pill); background: rgba(255, 255, 255, 0.6); overflow: hidden; margin-top: 0.5rem; }
.progress-bar { height: 100%; width: 0; background: linear-gradient(90deg, var(--petal), var(--rose)); transition: width 0.3s ease; }
.progress-label { margin: 0.4rem 0 1.25rem; font-size: 0.92rem; color: var(--ink-soft); }
.field { margin-bottom: 1rem; }
label { display: block; margin-bottom: 0.3rem; font-weight: 600; }
.input-row { display: flex; gap: 0.5rem; }
input, textarea {
  width: 100%; padding: 0.7rem 1rem; border-radius: var(--radius-md); border: 1px solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.62); color: var(--ink); font: inherit;
}
textarea { resize: vertical; }
::placeholder { color: #946880; opacity: 1; }
.dice { flex: none; width: 3rem; border-radius: var(--radius-md); border: 1px solid var(--glass-edge); background: var(--glass-strong); font-size: 1.2rem; cursor: pointer; }
.dice:hover { background: #fff; }
.field.invalid input { border-color: var(--rose-deep); }
.field-error, .form-error { color: #a3305a; font-size: 0.92rem; margin: 0.3rem 0 0; }
.form-error ul { margin: 0 0 1rem; padding-left: 1.2rem; }
.hint { margin: 0.4rem 0 0; font-size: 0.92rem; color: var(--ink-soft); }

/* result */
.result { max-width: 820px; margin: 0 auto; }
.story-final { font-size: clamp(1.15rem, 2.2vw, 1.4rem); line-height: 2; }
@keyframes pop {
  from { opacity: 0; transform: translateY(0.3em) scale(0.9); filter: blur(4px); }
  to { opacity: 1; transform: none; filter: none; }
}
.story-final.reveal mark.word { animation: pop 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(var(--i, 0) * 170ms + 250ms); }
.copy-status { min-height: 1.5rem; margin: 0.75rem 0 0; color: var(--rose-deep); font-weight: 500; }

@media (max-width: 820px) {
  .play-layout { grid-template-columns: 1fr; }
  .preview-panel { position: static; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
